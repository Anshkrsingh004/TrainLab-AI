# Backend environment (for running the API standalone, outside docker-compose).
# Copy to .env and adjust as needed. Defaults already target a local Postgres.

ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=trainlab
POSTGRES_PASSWORD=trainlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trainlab

# PLACEHOLDER — configured for Release 2, unused in Release 1.
REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Session signing key — override with a strong random value in production.
SECRET_KEY=dev-insecure-secret-change-me

# OAuth credentials (see docs/AUTH_SETUP.md). Blank disables the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
