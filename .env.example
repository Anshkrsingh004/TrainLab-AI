# Root environment for docker-compose. Copy to .env and adjust as needed.

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=trainlab
POSTGRES_PASSWORD=trainlab
POSTGRES_DB=trainlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (PLACEHOLDER — configured for Release 2, unused in Release 1) ──
REDIS_URL=redis://localhost:6379/0

# ── Backend ───────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Session signing key — generate a strong random value for real deployments,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=dev-insecure-secret-change-me

# ── OAuth credentials (see docs/AUTH_SETUP.md) ────────────────────
# Leave blank to disable a provider. Never commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────
# Where the Next.js server proxies /api/* requests (server-side only).
BACKEND_URL=http://localhost:8000
