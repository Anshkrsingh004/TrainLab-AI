# Root environment for docker-compose. Copy to .env and adjust as needed.

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=trainlab
POSTGRES_PASSWORD=trainlab
POSTGRES_DB=trainlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (PLACEHOLDER — configured for Release 2, unused in Release 1) ──
REDIS_URL=redis://localhost:6379/0

# ── Backend ───────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
